{
  "compilerOptions": {
    "target": "ES2023",
    "module": "CommonJS",
    "moduleResolution": "Node",

    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "alwaysStrict": true,

    "skipLibCheck": true,

    "lib": ["ES2023"],
    "types": ["node"],

    "outDir": "lib",

    "sourceMap": true,
    "inlineSourceMap": false,

    "declaration": true,
    "declarationMap": true,

    "noEmitOnError": true,
    "noEmitHelpers": true,
    "importHelpers": false,

    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,

    "useUnknownInCatchVariables": false,
    "useDefineForClassFields": false
  },

  "ts-node": {
    "transpileOnly": true
  },

  "include": ["src/**/*"]
}